# Vercel Environment Variables — Link Calculator Secure Deployment
# Set these in: Vercel Dashboard → Your Project → Settings → Environment Variables
# (or via Vercel CLI: vercel env add <NAME>)

# Your Supabase project URL
# Found at: Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase service role key (KEEP SECRET — never expose in the browser)
# Found at: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# The URL where your frontend is hosted — used for CORS
# Example: https://link.nucleus.coffee  or  https://your-project.vercel.app
ALLOWED_ORIGIN=https://your-project.vercel.app
